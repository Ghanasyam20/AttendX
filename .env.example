# AttendX Environment Variables
# Copy this file to .env and fill in your values (for local development)
# For Vercel, add these as environment variables in the dashboard

# Session Configuration
ATTENDX_SESSION_COOKIE_DOMAIN=yourdomain.com

# CORS Configuration (comma-separated origins)
ATTENDX_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration (only if using PostgreSQL)
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Option 2: Use individual variables
# DB_NAME=attendx
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Flask Configuration (optional)
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Face Recognition (optional, for advanced features)
FACE_RECOGNITION_ENABLED=true
FACE_RECOGNITION_THRESHOLD=0.6

# Logging (optional)
LOG_LEVEL=INFO

# Server Configuration (optional)
SERVER_NAME=yourdomain.com
PREFERRED_URL_SCHEME=https
